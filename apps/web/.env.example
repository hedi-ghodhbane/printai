# Supabase (optional — without these the app runs in local/guest-only mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only: used by server functions to write orders on behalf of guests
SUPABASE_SERVICE_ROLE_KEY=
# Public site URL used for OAuth redirects (e.g. https://printai.tn)
VITE_SITE_URL=http://localhost:3000
